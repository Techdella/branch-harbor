# BranchHarbor API (server-side fetches and the same-origin /api proxy forward here).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional runtime override of the API URL for server code (NEXT_PUBLIC_* is inlined at build time).
# API_URL=
# Public base URL of the included address (https://sites.branchharbor.com in production).
# Requests to this host are routed by path (/{brand}/{location}); any other host is treated as a
# connected custom domain and resolved through GET /v1/public/sites/resolve-host.
SITES_BASE_URL=http://localhost:3002
# Optional: extra hostnames that should be treated as the included address (comma separated).
SITES_EXTRA_HOSTS=127.0.0.1
# Trusted proxies in front of the sites app; the visitor IP is read this many entries from the right of X-Forwarded-For
SITES_TRUSTED_PROXY_HOPS=1
