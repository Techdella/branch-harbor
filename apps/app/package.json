{
  "name": "@bh/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "lint:strings": "node ../../scripts/i18n/lint-strings.mjs --root src --allow i18n-allowlist.json",
    "lint": "pnpm run check:messages && pnpm run lint:strings"
  },
  "dependencies": {
    "@bh/icons": "workspace:*",
    "@bh/shared": "workspace:*",
    "@bh/tokens": "workspace:*",
    "@bh/ui": "workspace:*",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
