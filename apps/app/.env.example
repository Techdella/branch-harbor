# BranchHarbor business app (app.branchharbor.com)
# Backend base URL (apps/api). Routes are served under /v1.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Use the built-in mock data layer (sample organisations, international locations) — zero setup.
# Set to "false" to use the API: sign in with a real account (after `pnpm --filter @bh/api db:seed`:
# demo@branchharbor.com and the seed password). If the API is unreachable the app falls back to sample data and says so.
# Both values are inlined at build time; rebuild after changing them.
NEXT_PUBLIC_USE_MOCKS=true
