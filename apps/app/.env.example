# BranchHarbor business app (app.branchharbor.com)
# Backend base URL. Routes are served under /v1.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Use the built-in mock data layer (sample organisations, international locations).
# Set to "false" to call the API. If the API is unreachable the app falls back to mocks and says so.
NEXT_PUBLIC_USE_MOCKS=true
