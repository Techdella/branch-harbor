{
  "name": "@bh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@bh/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "5.61.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.8.2",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
