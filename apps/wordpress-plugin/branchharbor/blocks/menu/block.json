{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "branchharbor/menu",
	"version": "1.0.0",
	"title": "Menu",
	"category": "branchharbor",
	"icon": "food",
	"description": "Menu with local prices and availability.",
	"keywords": [
		"menu",
		"food",
		"restaurant"
	],
	"textdomain": "branchharbor",
	"attributes": {
		"locationId": {
			"type": "string",
			"default": ""
		},
		"category": {
			"type": "string",
			"default": ""
		},
		"showPrices": {
			"type": "boolean",
			"default": true
		},
		"showDietary": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "branchharbor-blocks-editor",
	"style": "branchharbor-blocks",
	"viewScript": "branchharbor-blocks-view"
}
