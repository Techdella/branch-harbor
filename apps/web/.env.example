# Backend API that receives demo requests (POST /v1/public/demo-requests)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Business app (sign-in lives there)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Public origin of this site: canonical URLs, hreflang alternates, sitemap.xml, OpenGraph images
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Cloudflare Turnstile site key. When set, the demo form shows the widget and sends
# `turnstileToken`; the API must then verify it with TURNSTILE_SECRET_KEY (see README).
# Cloudflare test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
