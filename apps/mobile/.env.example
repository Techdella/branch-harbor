# BranchHarbor mobile — copy to .env (Expo loads EXPO_PUBLIC_* at build time).
# Base URL of the BranchHarbor API (apps/api). Routes are under /v1.
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# true (default): use the in-app mock layer so the app runs without the backend.
EXPO_PUBLIC_USE_MOCKS=true

# Stripe publishable key (pk_test_...). When empty, payment steps show
# "Payments not configured" and bookings/orders that need payment can't be completed.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Apple Pay merchant identifier for the Stripe config plugin (iOS builds only).
STRIPE_MERCHANT_IDENTIFIER=merchant.com.branchharbor.app
